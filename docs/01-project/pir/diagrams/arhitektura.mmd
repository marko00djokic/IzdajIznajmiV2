    F[(Замрзнути JSON)] --> CLI[pir:evaluate]
    CLI --> EV[PirOfflineEvaluator]
    EV --> J[(Три листе у JSON)]
  end
  subgraph P[ПРЕДЛОЖЕНО — мастер рад]
    direction LR
    W[Унос тежина] -.-> NEW[Нови API уговор]
    NEW -.-> UX[Независна и UX провера]
  end
  I ~~~ L
